rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'raj.asusrog@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin() || (resource.data != null && resource.data.email == request.auth.token.email));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Deed documents
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Security Audit Logs
    match /audit_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}

